PAPER   := paper
LATEXMK := latexmk -pdf -interaction=nonstopmode -halt-on-error

# Requirements: a TeX Live with the acmart class plus its dependencies --
# collection-publishers, collection-latexextra, collection-fontsextra.
# Under this project's nix setup these come from the home-manager
# texlive.combine; otherwise: brew install --cask mactex-no-gui (macOS) or
# apt install texlive-full (Ubuntu).
# Sanity check : kpsewhich acmart.cls    (must print a path)
#
# The Results tables are generated by the analysis pipeline. Run it first:
#   (cd ../analysis && make)

.PHONY: all clean watch check-deps

check-deps:
	@kpsewhich acmart.cls >/dev/null 2>&1 \
	  || { echo "acmart.cls not found -- install collection-publishers / texliveFull"; exit 1; }
	@command -v latexmk >/dev/null 2>&1 || { echo "latexmk missing"; exit 1; }

all: check-deps $(PAPER).pdf

$(PAPER).pdf: $(PAPER).tex references.bib
	$(LATEXMK) $(PAPER).tex

watch:
	$(LATEXMK) -pvc $(PAPER).tex

clean:
	latexmk -C
	rm -f *.aux *.log *.out *.bbl *.blg *.fdb_latexmk *.fls *.synctex.gz
